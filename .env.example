# ── required ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/dsc_erp"
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"
APP_URL="http://localhost:3000"

# ── files (uploads, site photos, challans) ───────────────────────────────
# Local disk – fine on your own computer or a server with a permanent disk:
UPLOAD_DIR="./uploads"
# On Vercel there is no permanent disk. Easiest: keep files in the database (no extra account):
# STORAGE_DRIVER="db"
# Or use an S3-compatible bucket
# (AWS S3, Cloudflare R2, Supabase Storage, DigitalOcean Spaces). Keep it PRIVATE.
# STORAGE_DRIVER="s3"
# S3_BUCKET="dsc-files"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # leave out for AWS S3
# S3_FORCE_PATH_STYLE="false"

# ── scheduler ────────────────────────────────────────────────────────────
# 16+ characters. Lets Vercel Cron run the daily reminders at 7:00 AM IST (see vercel.json).
# CRON_SECRET=""

# Reading bills from a photo (optional). Leave empty to keep the "Read the bill" step switched off: the photo of the bill is still saved with the
# expense or vendor bill. Set the key in the hosting settings (never in a file that is shared). BILL_MODEL is optional: a cheaper model costs
# less per bill but may read handwriting less well. The default is the most accurate.
ANTHROPIC_API_KEY=""
BILL_MODEL=""
